# انسخ هذا الملف إلى .env على السيرفر وعبّئ القيم. لا ترفع .env على GitHub.

# رابط الدخول للوحة التحكم يصير: https://موقعك/admin/connect/<هذا المفتاح>
# ولّد مفتاح طويل:  openssl rand -base64 32 | tr -d '/+='
ADMIN_SETUP_KEY=

# يشفّر مفاتيح Resend و Moyasar المحفوظة من لوحة التحكم. لا تغيّره بعد التشغيل.
# ولّده بنفس الأمر فوق.
SETTINGS_SECRET=

# مكان قاعدة البيانات والملفات المرفوعة (خذ نسخة احتياطية منه)
DATA_DIR=/var/lib/safar
PORT=3000

# Public address of the site, used in payment links (e.g. https://safarstudio.sa)
PUBLIC_URL=
