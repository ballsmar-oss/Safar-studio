# انسخ هذا الملف إلى .env وعبّي القيم
PORT=3000
# التوكن اللي تدخل فيه لوحة التحكم (#/admin) — خلّه طويل وعشوائي
ADMIN_TOKEN=
# مفتاح تشفير مفاتيح التكاملات المحفوظة — لا تغيّره بعد التشغيل
SETTINGS_SECRET=
# رابط الموقع العام (تقدر تحطه من لوحة التحكم ← الإعدادات بدلاً منه)
PUBLIC_URL=https://satr.sa
# مكان قاعدة البيانات والملفات المرفوعة
DATA_DIR=data
